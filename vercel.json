{
  "crons": [
    { "path": "/api/public/cron/reminders", "schedule": "0 6 * * *" },
    { "path": "/api/public/cron/reminders", "schedule": "0 18 * * *" },
    { "path": "/api/public/cron/mining", "schedule": "*/15 * * * *" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, s-maxage=2592000" }]
    }
  ]
}
